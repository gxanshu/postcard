<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>in.gxanshu.postcard</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Postcard</name>
  <summary>A modern email client for GNOME</summary>
  <description>
    <p>
      Postcard is a fast, modern email client for the GNOME desktop, built with GTK 4 and
      libadwaita. It follows the same three-pane layout as Geary — folders, conversations,
      and reading pane — with a clean, native feel and nothing to configure to get started
      beyond your account details.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Multiple IMAP/SMTP accounts, with TLS or STARTTLS</li>
      <li>Conversations grouped into threads, nested folders shown as a tree</li>
      <li>Instant full-text search across your mail</li>
      <li>Offline reading from a local cache, and syncing that carries on in the
      background</li>
      <li>HTML and plain-text mail, with remote images blocked until you allow them</li>
      <li>Rich-text composer with formatting, lists, links, and recipient autocomplete</li>
      <li>Optional sender avatars from Gravatar, falling back to the sender's site icon</li>
      <li>Compose, reply, and forward, with Cc/Bcc, a signature, and a Drafts/Outbox that
      never loses a message</li>
      <li>Archive, trash, move, and undo, with desktop notifications for new mail</li>
    </ul>
  </description>

  <developer id="in.gxanshu">
    <name>Anshu</name>
  </developer>

  <url type="homepage">https://github.com/gxanshu/postcard</url>
  <url type="vcs-browser">https://github.com/gxanshu/postcard</url>
  <url type="bugtracker">https://github.com/gxanshu/postcard/issues</url>

  <translation type="gettext">postcard</translation>
  <launchable type="desktop-id">in.gxanshu.postcard.desktop</launchable>

  <provides>
    <mediatype>x-scheme-handler/mailto</mediatype>
  </provides>

  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#488ed2</color>
    <color type="primary" scheme_preference="dark">#306bb4</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <caption>The three-pane layout with folders, conversations, and reader</caption>
      <image>https://raw.githubusercontent.com/gxanshu/postcard/main/data/screenshots/main-window.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.11.1" date="2026-08-29">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>Accounts can now sign in with a username that differs from the email
          address, for servers whose login is not the address</li>
          <li>The Attachments heading in the composer is hidden until a file is
          attached</li>
        </ul>
      </description>
    </release>
    <release version="1.11.0" date="2026-08-28">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>An All Inboxes view that puts new mail from every account in one list</li>
          <li>A tray icon with an unread badge, for desktops that show one (KDE, Xfce and
          friends)</li>
          <li>Accounts can now be named in the sidebar by their display name instead of
          their address</li>
          <li>Quit is now in the main menu</li>
          <li>Mail opens faster — the IMAP connection is kept alive between operations</li>
          <li>Start at Login now falls back to an autostart file where the desktop portal
          does not answer (Xfce, Cinnamon, MATE, LXQt, Budgie)</li>
          <li>Fix a Bin or Deleted Items folder not being recognised as trash</li>
          <li>Fix a crash when right-clicking a conversation</li>
          <li>Fix moves, flag changes and the Outbox acting on the wrong account in the
          unified view</li>
          <li>Fix the conversation list shifting after a refresh</li>
        </ul>
      </description>
    </release>
    <release version="1.10.1" date="2026-08-22">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>Fix connecting to a local mail bridge with a self-signed certificate</li>
        </ul>
      </description>
    </release>
    <release version="1.10.0" date="2026-08-22">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>A unified inbox that shows mail from every account in one list</li>
          <li>One-click unsubscribe from mailing lists, straight from the reader</li>
          <li>Pick which account a message is sent from in the composer</li>
          <li>Postcard can now start on login and keep syncing in the background</li>
          <li>Remote images and other subresources in messages are now blocked by default</li>
          <li>IMAP and SMTP connections now verify TLS certificates</li>
          <li>Only http, https and mailto links open from a message body</li>
          <li>Attachments now prompt for an app when nothing is set to open them</li>
          <li>Fix the archive button not offering to unarchive already-archived mail</li>
          <li>Fix new-mail notifications from different accounts replacing each other</li>
          <li>Fix the conversation list emptying when a background sync failed</li>
          <li>Fix the unread filter showing a recording icon instead of a bell</li>
        </ul>
      </description>
    </release>
    <release version="1.9.1" date="2026-08-15">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>Add a Google account straight from GNOME Online Accounts — no app password
          to generate, and Postcard never sees a password</li>
          <li>The folder and conversation sidebars can now be resized</li>
          <li>Sent and Drafts now show the recipient's avatar instead of your own</li>
          <li>Faster startup, sync, and search</li>
          <li>Fix folders being matched and created by the wrong name</li>
          <li>Fix the black flash when a message first loads</li>
          <li>Fix the background-running notice appearing every launch</li>
          <li>Fix links in error messages not being clickable</li>
          <li>Fix conversations from one account showing up in another account's folders</li>
        </ul>
      </description>
    </release>
    <release version="1.9.0" date="2026-08-15">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>Add a Google account straight from GNOME Online Accounts — no app password
          to generate, and Postcard never sees a password</li>
          <li>The folder and conversation sidebars can now be resized</li>
          <li>Sent and Drafts now show the recipient's avatar instead of your own</li>
          <li>Faster startup, sync, and search</li>
          <li>Fix folders being matched and created by the wrong name</li>
          <li>Fix the black flash when a message first loads</li>
          <li>Fix the background-running notice appearing every launch</li>
          <li>Fix links in error messages not being clickable</li>
        </ul>
      </description>
    </release>
    <release version="1.8.0" date="2026-08-09">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>Reply-all, alongside reply and forward</li>
          <li>Attachments now open directly in their default app</li>
          <li>Relative dates ("2h ago", "Yesterday") in the conversation list and reader</li>
          <li>A refreshed reader header with clearer actions</li>
          <li>Sender addresses can now be selected and copied</li>
          <li>Fix the composer closing the message behind it in the reader</li>
        </ul>
      </description>
    </release>
    <release version="1.7.0" date="2026-08-06">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>Adding an account now fills in the IMAP and SMTP settings for you — most
          providers need nothing but an address and a password</li>
          <li>A modernized reading pane</li>
          <li>Postcard is now available on the AUR, and ships aarch64 builds alongside
          x86_64</li>
          <li>Postcard now releases memory while it sits in the background</li>
          <li>Fix several wrong icons around the interface</li>
        </ul>
      </description>
    </release>
    <release version="1.6.2" date="2026-08-02">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>One-click install: Postcard now ships a .flatpakref, so adding the repository by hand is no longer needed</li>
        </ul>
      </description>
    </release>
    <release version="1.6.1" date="2026-08-02">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>Fix sent mail never appearing in Sent on the server</li>
          <li>Fix read and starred marks not following what the server reports</li>
          <li>Fix unread counts going stale in folders other than the Inbox</li>
        </ul>
      </description>
    </release>
    <release version="1.6.0" date="2026-08-01">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>Postcard can now be your default mail client — mailto: links open the composer
          with the recipient, subject and body already filled in</li>
          <li>Select several conversations at once and archive, move or trash them together,
          from the list or the right-click menu</li>
          <li>Fix sending reporting success when the server had actually rejected the
          message</li>
          <li>Fix crashes when opening mail from a notification and before an account has
          loaded</li>
          <li>Fix archived mail reappearing after a sync</li>
        </ul>
      </description>
    </release>
    <release version="1.5.0" date="2026-07-28">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>Optional sender avatars, fetched from Gravatar with the sender's site icon as a
          fallback — off by default</li>
          <li>Start hidden at login with --hidden and keep checking for mail in the
          background</li>
        </ul>
      </description>
    </release>
    <release version="1.4.0" date="2026-07-26">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>Rich-text composer with bold, italic, underline, strikethrough, bulleted and
          numbered lists, and links</li>
          <li>Mail is now sent as HTML with a plain-text alternative</li>
          <li>Recipient autocomplete from addresses seen in your existing mail</li>
        </ul>
      </description>
    </release>
    <release version="1.3.0" date="2026-07-26">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>Nested folders now show as a tree, with non-ASCII folder names handled
          correctly</li>
          <li>Hide Gmail's empty [Gmail] container from the folder list</li>
          <li>Open links in your default browser instead of inside the app</li>
          <li>Show newly fetched mail right after a sync</li>
          <li>Fix mail opened from a notification being marked unread again</li>
        </ul>
      </description>
    </release>
    <release version="1.2.0" date="2026-07-21">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>Keep syncing in the background after the window is closed</li>
          <li>Refreshed application logo</li>
        </ul>
      </description>
    </release>
    <release version="1.1.1" date="2026-07-20">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>Bold unread subjects instead of relying on the dot</li>
          <li>Show a star icon for the starred mail folder</li>
          <li>Richer content in new mail notifications</li>
          <li>Show the latest mail first in the conversation view</li>
          <li>Fix folders with spaces in their names failing to open</li>
          <li>Remove the tooltip that lingered after the first sync</li>
          <li>Remove the accounts option from the primary menu</li>
        </ul>
      </description>
    </release>
    <release version="1.1.0" date="2026-07-20">
      <description translate="no">
        <p>New in this release:</p>
        <ul>
          <li>TLS/STARTTLS option for Proton Mail Bridge accounts</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2026-07-19">
      <description translate="no">
        <p>First release.</p>
        <ul>
          <li>Multiple IMAP/SMTP accounts with passwords stored in the system keyring</li>
          <li>Three-pane layout with conversation threading and full-text search</li>
          <li>Read HTML and plain-text mail, with remote-image blocking and attachments</li>
          <li>Compose, reply, and forward, with Cc/Bcc, a signature, and a Drafts/Outbox
          queue</li>
          <li>Archive, trash, move, and mark read/starred, with undo and desktop
          notifications</li>
        </ul>
      </description>
    </release>
  </releases>

</component>
